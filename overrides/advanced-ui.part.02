+    path.addRoundedRect(rect, std::max(0.0, radius), std::max(0.0, radius));
+    painter.fillPath(path, brush);
+}
+
+void draw_progress_classic(QPainter& painter, const QRectF& bar, double ratio,
+                           const RenderConfig& config)
+{
+    fill_rounded(painter, bar, bar.height() * 0.5,
+                 gradient_brush(config.progress_background, bar));
+    if (ratio <= 0.0) {
+        return;
+    }
+    QRectF fill = bar;
+    fill.setWidth(bar.width() * ratio);
+    const double radius = std::min(bar.height() * 0.5, fill.width() * 0.5);
+    fill_rounded(painter, fill, radius, gradient_brush(config.progress, bar));
+}
+
+void draw_progress_slim(QPainter& painter, const QRectF& bar, double ratio,
+                        const RenderConfig& config)
+{
+    const double line_height = std::max(1.0, bar.height() * 0.38);
+    const QRectF rail(bar.left(), bar.center().y() - line_height * 0.5, bar.width(), line_height);
+    fill_rounded(painter, rail, line_height * 0.5,
+                 gradient_brush(config.progress_background, bar));
+    if (ratio > 0.0) {
+        QRectF fill = rail;
+        fill.setWidth(rail.width() * ratio);
+        fill_rounded(painter, fill, std::min(line_height * 0.5, fill.width() * 0.5),
+                     gradient_brush(config.progress, bar));
+    }
+}
+
+void draw_progress_segmented(QPainter& painter, const QRectF& bar, double ratio,
+                             const RenderConfig& config)
+{
+    const int segments = std::clamp(static_cast<int>(bar.width() / std::max(24.0, bar.height() * 3.6)),
+                                    6, 32);
+    const double gap = std::clamp(bar.height() * 0.42, 1.5, 5.0);
+    const double total_gap = gap * static_cast<double>(segments - 1);
+    const double segment_width = std::max(1.0, (bar.width() - total_gap) / segments);
+    const QBrush background = gradient_brush(config.progress_background, bar);
+    const QBrush fill = gradient_brush(config.progress, bar);
+
+    auto draw_segments = [&](const QBrush& brush) {
+        for (int index = 0; index < segments; ++index) {
+            const double x = bar.left() + index * (segment_width + gap);
+            const QRectF segment(x, bar.top(), segment_width, bar.height());
+            fill_rounded(painter, segment, std::min(bar.height() * 0.35, segment_width * 0.35), brush);
+        }
+    };
+
+    draw_segments(background);
+    if (ratio > 0.0) {
+        painter.save();
+        painter.setClipRect(QRectF(bar.left(), bar.top(), bar.width() * ratio, bar.height()));
+        draw_segments(fill);
+        painter.restore();
+    }
+}
+
+void draw_progress_dots(QPainter& painter, const QRectF& bar, double ratio,
+                        const RenderConfig& config)
+{
+    const double diameter = std::max(2.0, bar.height());
+    const double usable_width = std::max(1.0, bar.width() - diameter);
+    const int dots = std::clamp(static_cast<int>(bar.width() / std::max(10.0, diameter * 1.65)), 8, 64);
+    const QBrush background = gradient_brush(config.progress_background, bar);
+    const QBrush fill = gradient_brush(config.progress, bar);
+
+    auto draw_dots = [&](const QBrush& brush) {
+        for (int index = 0; index < dots; ++index) {
+            const double t = dots <= 1 ? 0.0 : static_cast<double>(index) / (dots - 1);
+            const double x = bar.left() + diameter * 0.5 + usable_width * t;
+            painter.setPen(Qt::NoPen);
+            painter.setBrush(brush);
+            painter.drawEllipse(QPointF(x, bar.center().y()), diameter * 0.5, diameter * 0.5);
+        }
+    };
+
