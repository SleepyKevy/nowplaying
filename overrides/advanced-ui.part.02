+QColor apply_opacity(QColor color, int opacity_percent)
+{
+    const double multiplier = std::clamp(opacity_percent, 0, 100) / 100.0;
+    color.setAlpha(static_cast<int>(std::lround(color.alpha() * multiplier)));
+    return color;
+}
+
+int gradient_color_count(GradientMode mode)
+{
+    switch (mode) {
+    case GradientMode::three_color:
+        return 3;
+    case GradientMode::two_color:
+        return 2;
+    case GradientMode::solid:
+    default:
+        return 1;
+    }
+}
+
+QBrush gradient_brush(const GradientStyle& style, const QRectF& bounds, int opacity_percent = 100)
+{
+    const QColor color1 = apply_opacity(style.color1, opacity_percent);
+    if (style.mode == GradientMode::solid || bounds.isEmpty()) {
+        return QBrush(color1);
+    }
+
+    const QColor color2 = apply_opacity(style.color2, opacity_percent);
+    const QColor color3 = apply_opacity(style.color3, opacity_percent);
+    const double radians = style.angle * pi / 180.0;
+    const QPointF direction(std::cos(radians), std::sin(radians));
+    const double radius = std::max(1.0, std::hypot(bounds.width(), bounds.height()) * 0.5);
+    const QPointF center = bounds.center();
+    QLinearGradient gradient(center - direction * radius, center + direction * radius);
+    gradient.setColorAt(0.0, color1);
+    if (style.mode == GradientMode::three_color) {
+        gradient.setColorAt(0.5, color2);
+        gradient.setColorAt(1.0, color3);
+    } else {
+        gradient.setColorAt(1.0, color2);
+    }
+    return QBrush(gradient);
+}
+
+bool style_visible(const GradientStyle& style, int opacity_percent = 100)
+{
+    const int count = gradient_color_count(style.mode);
+    const QColor colors[3] = {
+        apply_opacity(style.color1, opacity_percent),
+        apply_opacity(style.color2, opacity_percent),
+        apply_opacity(style.color3, opacity_percent),
+    };
+    for (int index = 0; index < count; ++index) {
+        if (colors[index].alpha() > 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void set_gradient_pen(QPainter& painter, const GradientStyle& style, const QRectF& bounds,
+                      double width = 1.0, int opacity_percent = 100)
+{
+    QPen pen(gradient_brush(style, bounds, opacity_percent), width);
+    pen.setJoinStyle(Qt::RoundJoin);
+    pen.setCapStyle(Qt::RoundCap);
+    painter.setPen(pen);
+}
+
+void draw_line(QPainter& painter, const QString& text, const QFont& font,
+               const GradientStyle& style, const QRectF& bounds, TextAlignment alignment,
+               OverflowMode overflow, double marquee_seconds, double marquee_speed)
 {
     if (text.isEmpty() || bounds.width() <= 0.0 || bounds.height() <= 0.0) {
         return;
@@ -86,7 +142,7 @@ void draw_line(QPainter& painter, const QString& text, const QFont& font, const
 
