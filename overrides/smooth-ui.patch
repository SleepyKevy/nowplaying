+void update_visual_progress(NowPlayingSourceContext* context,
+                            const now_playing::TrackState& playback, double elapsed_seconds)
+{
+    if (!context) {
+        return;
+    }
+
+    const double duration_ms = static_cast<double>(std::max<std::int64_t>(0, playback.duration_ms));
+    const double provider_progress_ms = static_cast<double>(playback.estimated_progress_ms());
+    const bool track_changed = context->visual_progress_track_id != playback.track_id;
+
+    if (!context->visual_progress_initialized || track_changed || duration_ms <= 0.0) {
+        context->visual_progress_track_id = playback.track_id;
+        context->visual_progress_ms = std::clamp(provider_progress_ms, 0.0, duration_ms);
+        context->visual_progress_initialized = true;
+        return;
+    }
+
+    if (playback.status != now_playing::PlaybackStatus::playing) {
+        context->visual_progress_ms = std::clamp(provider_progress_ms, 0.0, duration_ms);
+        return;
+    }
+
+    const double dt = std::clamp(elapsed_seconds, 0.0, 0.25);
+    const double predicted_progress_ms = context->visual_progress_ms + dt * 1'000.0;
+    const double error_ms = provider_progress_ms - predicted_progress_ms;
+
+    // Large differences are intentional seeks. Small provider-clock corrections are
+    // slewed into the local frame clock instead of snapping the bar. This keeps the
+    // progress edge and mm:ss counter moving monotonically and smoothly between
+    // Windows media-session timeline updates.
+    if (std::abs(error_ms) >= seek_snap_threshold_ms) {
+        context->visual_progress_ms = provider_progress_ms;
+    } else {
+        const double correction_ms_per_second = std::clamp(
+            error_ms * clock_correction_gain, -maximum_clock_correction_ms_per_second,
+            maximum_clock_correction_ms_per_second);
+        context->visual_progress_ms =
+            predicted_progress_ms + dt * correction_ms_per_second;
+    }
+
+    context->visual_progress_ms = std::clamp(context->visual_progress_ms, 0.0, duration_ms);
+}
+
+now_playing::TrackState make_render_state(const NowPlayingSourceContext* context)
+{
+    now_playing::TrackState state = context->playback;
+    if (context->visual_progress_initialized && state.duration_ms > 0) {
+        state.progress_ms = static_cast<std::int64_t>(std::llround(context->visual_progress_ms));
+        state.observed_at = std::chrono::steady_clock::now();
+    }
+    return state;
+}
