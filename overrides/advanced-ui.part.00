diff --git a/src/obs/now-playing-source.cpp b/src/obs/now-playing-source.cpp
index 5666e8d..9db6ca5 100644
--- a/src/obs/now-playing-source.cpp
+++ b/src/obs/now-playing-source.cpp
@@ -115,6 +115,50 @@ now_playing::TransitionStyle parse_transition(const char* value)
     return now_playing::TransitionStyle::none;
 }
 
+now_playing::GradientMode parse_gradient_mode(const char* value)
+{
+    if (value && std::string(value) == "three") {
+        return now_playing::GradientMode::three_color;
+    }
+    if (value && std::string(value) == "two") {
+        return now_playing::GradientMode::two_color;
+    }
+    return now_playing::GradientMode::solid;
+}
+
+now_playing::ProgressStyle parse_progress_style(const char* value)
+{
+    if (value && std::string(value) == "slim") {
+        return now_playing::ProgressStyle::slim;
+    }
+    if (value && std::string(value) == "segmented") {
+        return now_playing::ProgressStyle::segmented;
+    }
+    if (value && std::string(value) == "dots") {
+        return now_playing::ProgressStyle::dots;
+    }
+    if (value && std::string(value) == "slider") {
+        return now_playing::ProgressStyle::slider;
+    }
+    return now_playing::ProgressStyle::classic;
+}
+
+now_playing::GradientStyle read_gradient(obs_data_t* settings, const char* mode_key,
+                                         const char* color1_key, const char* color2_key,
+                                         const char* color3_key, const char* angle_key)
+{
+    now_playing::GradientStyle style;
+    style.mode = parse_gradient_mode(obs_data_get_string(settings, mode_key));
+    style.color1 =
+        to_qcolor(static_cast<std::uint32_t>(obs_data_get_int(settings, color1_key)));
+    style.color2 =
+        to_qcolor(static_cast<std::uint32_t>(obs_data_get_int(settings, color2_key)));
+    style.color3 =
+        to_qcolor(static_cast<std::uint32_t>(obs_data_get_int(settings, color3_key)));
+    style.angle = obs_data_get_double(settings, angle_key);
+    return style;
+}
