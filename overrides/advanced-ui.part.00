+void add_gradient_mode_items(obs_property_t* property)
+{
+    add_list_item(property, "NowPlayingSource.Solid", "solid");
+    add_list_item(property, "NowPlayingSource.TwoColorGradient", "two");
+    add_list_item(property, "NowPlayingSource.ThreeColorGradient", "three");
+}
+
+void add_gradient_controls(obs_properties_t* properties, const char* mode_name,
+                           const char* mode_label_key, const char* color1_name,
+                           const char* color1_label_key, const char* color2_name,
+                           const char* color2_label_key, const char* color3_name,
+                           const char* color3_label_key, const char* angle_name,
+                           const char* angle_label_key)
+{
+    obs_property_t* mode = obs_properties_add_list(
+        properties, mode_name, obs_module_text(mode_label_key), OBS_COMBO_TYPE_LIST,
+        OBS_COMBO_FORMAT_STRING);
+    add_gradient_mode_items(mode);
+    obs_properties_add_color_alpha(properties, color1_name, obs_module_text(color1_label_key));
+    obs_properties_add_color_alpha(properties, color2_name, obs_module_text(color2_label_key));
+    obs_properties_add_color_alpha(properties, color3_name, obs_module_text(color3_label_key));
+    obs_properties_add_float_slider(properties, angle_name, obs_module_text(angle_label_key), 0.0,
+                                    360.0, 1.0);
+}
+
