+    draw_dots(background);
+    if (ratio > 0.0) {
+        painter.save();
+        painter.setClipRect(QRectF(bar.left(), bar.top(), bar.width() * ratio, bar.height()));
+        draw_dots(fill);
+        painter.restore();
+    }
+}
+
+void draw_progress_slider(QPainter& painter, const QRectF& bar, double ratio,
+                          const RenderConfig& config)
+{
+    const double knob_diameter = std::max(3.0, bar.height());
+    const double knob_radius = knob_diameter * 0.5;
+    const double rail_height = std::max(1.5, bar.height() * 0.30);
+    const double rail_left = bar.left() + knob_radius;
+    const double rail_width = std::max(1.0, bar.width() - knob_diameter);
+    const QRectF rail(rail_left, bar.center().y() - rail_height * 0.5, rail_width, rail_height);
+    fill_rounded(painter, rail, rail_height * 0.5,
+                 gradient_brush(config.progress_background, bar));
+
+    const double progress_x = rail.left() + rail.width() * ratio;
+    if (ratio > 0.0) {
+        QRectF fill = rail;
+        fill.setWidth(rail.width() * ratio);
+        fill_rounded(painter, fill, rail_height * 0.5, gradient_brush(config.progress, bar));
+    }
+
+    painter.setPen(Qt::NoPen);
+    painter.setBrush(gradient_brush(config.progress, bar));
+    painter.drawEllipse(QPointF(progress_x, bar.center().y()), knob_radius, knob_radius);
+}
+
+void draw_progress_bar(QPainter& painter, const QRectF& bar, double ratio,
+                       const RenderConfig& config)
+{
+    ratio = std::clamp(ratio, 0.0, 1.0);
+    switch (config.progress_style) {
+    case ProgressStyle::slim:
+        draw_progress_slim(painter, bar, ratio, config);
+        break;
+    case ProgressStyle::segmented:
+        draw_progress_segmented(painter, bar, ratio, config);
+        break;
+    case ProgressStyle::dots:
+        draw_progress_dots(painter, bar, ratio, config);
+        break;
+    case ProgressStyle::slider:
+        draw_progress_slider(painter, bar, ratio, config);
+        break;
+    case ProgressStyle::classic:
+    default:
+        draw_progress_classic(painter, bar, ratio, config);
+        break;
+    }
 }
 
 } // namespace
